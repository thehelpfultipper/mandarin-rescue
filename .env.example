# Required for local Node server adaptation (/api/gemini/adapt).
# Copy to .env for `npm run dev` / `npm start`.
# GitHub Pages cannot use this key — host an API separately or rely on curated fallbacks.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: when the static PWA is on Pages and the API is elsewhere
# VITE_API_BASE="https://your-api.example.com"
